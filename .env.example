# FreeBCI DAQ — Environment Configuration
# Copy this file to .env and adjust values for your EEG hardware.
# See TUNING.md for detailed guidance.

# ---- Engagement Index ----
# EMA smoothing factor for EI (0.01–1.0, lower = smoother)
VITE_EMA_ALPHA=0.1

# Trend chart alert threshold (EI below this turns red)
VITE_ALERT_THRESHOLD=0.3

# Seconds to skip at stream start (device warmup)
VITE_INITIAL_UNRELIABLE=30

# ---- Focus Calibration ----
# Baseline collection window (seconds)
VITE_FOCUS_BASELINE=15

# Decision window default (seconds)
VITE_FOCUS_DECISION=15

# Warmup seconds before baseline (must match VITE_INITIAL_UNRELIABLE)
VITE_FOCUS_WARMUP=30
